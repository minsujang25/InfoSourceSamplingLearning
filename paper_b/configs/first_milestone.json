{
  "design_version": 2,
  "status": "theory_aligned_reconstruction",
  "description": "Receiver-side diagnostic grid before full production simulation.",
  "factors": {
    "initial_belief_regime": [
      "flat",
      "consensus",
      "polarized"
    ],
    "reliance_mode": [
      "adaptive",
      "frozen"
    ],
    "network_environment": [
      "elite_only",
      "random_peer",
      "homophilous_peer",
      "extended"
    ],
    "jammer_active": [
      true,
      false
    ]
